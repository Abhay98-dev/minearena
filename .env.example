GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEFAULT_PROVIDER=gemini
LLM_FALLBACK=              # optional: mock or ollama; keep empty to expose Gemini failures
LLM_TIMEOUT_S=30
MAX_INPUT_CHARS=20000
AUDIT_DB_PATH=audit.db
CORS_ORIGINS=http://localhost:5173
PRIVACY_NER=both           # heuristic | gliner | both
PRIVACY_USE_PRESIDIO=1
GLINER_MODEL=urchade/gliner_multi_pii-v1
SPACY_MODEL=en_core_web_sm
UPI_HANDLES=                    # optional extra UPI handles, comma-separated
MOCK_MODE=echo             # echo|reorder|drop|paraphrase|unknown|fail|timeout
